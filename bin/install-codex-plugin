#!/usr/bin/env sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
codex_root=${CODEX_HOME:-"$HOME/.codex"}
creator="$codex_root/skills/.system/plugin-creator/scripts/create_basic_plugin.py"
validator="$codex_root/skills/.system/plugin-creator/scripts/validate_plugin.py"
marketplace_reader="$codex_root/skills/.system/plugin-creator/scripts/read_marketplace_name.py"
cachebuster="$codex_root/skills/.system/plugin-creator/scripts/update_plugin_cachebuster.py"
plugin_parent=${BUILDROOM_PLUGIN_PARENT:-"$HOME/plugins"}
destination="$plugin_parent/buildroom"
legacy_destination="$plugin_parent/product-os"
marketplace=${BUILDROOM_MARKETPLACE_PATH:-"$HOME/.agents/plugins/marketplace.json"}
codex_command=${BUILDROOM_CODEX_COMMAND:-codex}
graphify_command=${BUILDROOM_GRAPHIFY_COMMAND:-graphify}
uv_command=${BUILDROOM_UV_COMMAND:-uv}
pipx_command=${BUILDROOM_PIPX_COMMAND:-pipx}
dry_run=false

usage() {
  cat <<'EOF'
Usage: bin/install-codex-plugin [--dry-run]

Builds and validates Buildroom, then installs it from the personal Codex marketplace.
Graphify is a required companion and is installed separately when it is missing.
EOF
}

find_graphify() {
  if command -v "$graphify_command" >/dev/null 2>&1; then
    command -v "$graphify_command"
    return 0
  fi
  if command -v "$uv_command" >/dev/null 2>&1; then
    graphify_bin=$("$uv_command" tool dir --bin 2>/dev/null || true)
    if [ -n "$graphify_bin" ] && [ -x "$graphify_bin/graphify" ]; then
      printf '%s\n' "$graphify_bin/graphify"
      return 0
    fi
  fi
  if command -v "$pipx_command" >/dev/null 2>&1; then
    graphify_bin=$("$pipx_command" environment --value PIPX_BIN_DIR 2>/dev/null || true)
    if [ -n "$graphify_bin" ] && [ -x "$graphify_bin/graphify" ]; then
      printf '%s\n' "$graphify_bin/graphify"
      return 0
    fi
  fi
  return 1
}

python_graphify_compatible() {
  python3 -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 10) else 1)' >/dev/null 2>&1
}

provision_graphify() {
  if find_graphify; then
    graphify_bin=$(find_graphify)
    printf 'Graphify is already installed at %s; preserving its version.\n' "$graphify_bin"
  else
    if ! command -v "$uv_command" >/dev/null 2>&1 && ! command -v "$pipx_command" >/dev/null 2>&1; then
      printf 'Graphify is missing. Install Python 3.10+ and either uv or pipx, then rerun this installer. See https://graphify.dev/installation.\n' >&2
      return 1
    fi
    if ! command -v "$uv_command" >/dev/null 2>&1 && ! python_graphify_compatible; then
      printf 'Graphify requires Python 3.10 or newer. Install or select Python 3.10+ and retry.\n' >&2
      return 1
    fi
    if command -v "$uv_command" >/dev/null 2>&1; then
      printf 'Installing Graphify CLI package graphifyy with uv.\n'
      if ! "$uv_command" tool install --python '>=3.10' graphifyy; then
        if command -v "$pipx_command" >/dev/null 2>&1; then
          printf 'uv installation failed; trying the available pipx fallback.\n' >&2
          if ! "$pipx_command" install graphifyy; then
            printf 'Graphify installation failed with both uv and pipx. Repair either package manager and retry.\n' >&2
            return 1
          fi
        else
          printf 'Graphify installation with uv failed. Repair uv/Python access and rerun this installer before replacing Buildroom.\n' >&2
          return 1
        fi
      fi
    elif command -v "$pipx_command" >/dev/null 2>&1; then
      printf 'Installing Graphify CLI package graphifyy with pipx.\n'
      if ! "$pipx_command" install graphifyy; then
        printf 'Graphify installation with pipx failed. Repair pipx/Python access and rerun this installer before replacing Buildroom.\n' >&2
        return 1
      fi
    fi
    if ! find_graphify; then
      printf 'Graphify was installed, but its graphify command is not available. Add the uv or pipx tool bin directory to PATH, open a new terminal, and rerun this installer.\n' >&2
      return 1
    fi
    graphify_bin=$(find_graphify)
  fi
  printf 'Registering Graphify for Codex.\n'
  if ! "$graphify_bin" install --platform codex; then
    printf 'Graphify Codex skill registration failed. Repair the Graphify install and rerun this installer before replacing Buildroom.\n' >&2
    return 1
  fi
}

case ${1:-} in
  '') ;;
  --dry-run) dry_run=true ;;
  -h|--help) usage; exit 0 ;;
  *) usage >&2; exit 2 ;;
esac

if [ "${PRODUCT_OS_PLUGIN_PARENT+x}" = x ] || [ "${PRODUCT_OS_MARKETPLACE_PATH+x}" = x ] || [ "${PRODUCT_OS_CODEX_COMMAND+x}" = x ]; then
  printf 'PRODUCT_OS_* installer overrides are no longer supported. Rename them to BUILDROOM_* before retrying.\n' >&2
  exit 2
fi

stage=$(mktemp -d "${TMPDIR:-/tmp}/buildroom-plugin-install.XXXXXX")
backup=''
bootstrap=''
legacy_backup=''
cleanup() {
  rm -rf "$stage"
  if [ -n "$bootstrap" ] && [ -d "$bootstrap" ]; then
    rm -rf "$bootstrap"
  fi
  if [ -n "$backup" ] && [ -e "$backup" ]; then
    rm -rf "$backup"
  fi
  if [ -n "$legacy_backup" ] && [ -e "$legacy_backup" ]; then
    rm -rf "$legacy_backup"
  fi
}
trap cleanup EXIT HUP INT TERM

"$root/bin/build-knowledge" --check
"$root/bin/build-codex-plugin" --output "$stage/buildroom" --write
if python3 -c 'import yaml' >/dev/null 2>&1; then
  python3 "$validator" "$stage/buildroom"
elif command -v "$uv_command" >/dev/null 2>&1 || command -v uv >/dev/null 2>&1; then
  validator_uv=$uv_command
  if ! command -v "$validator_uv" >/dev/null 2>&1; then
    validator_uv=uv
  fi
  "$validator_uv" run --with pyyaml python "$validator" "$stage/buildroom"
else
  printf 'Buildroom plugin validation needs PyYAML. Install it for Python or install uv and retry.\n' >&2
  exit 1
fi

if [ "$dry_run" = true ]; then
  if find_graphify; then
    printf 'dry-run: Graphify is already installed; would ensure its Codex skill registration.\n'
  elif command -v "$uv_command" >/dev/null 2>&1 || { python_graphify_compatible && command -v "$pipx_command" >/dev/null 2>&1; }; then
    printf 'dry-run: Graphify is missing; would install graphifyy with %s and register its Codex skill.\n' "$(if command -v "$uv_command" >/dev/null 2>&1; then printf uv; else printf pipx; fi)"
  else
    printf 'dry-run: Graphify is missing and prerequisites are incomplete; Python 3.10+ and uv or pipx are required.\n'
  fi
  printf 'dry-run: would install validated plugin at %s and use %s\n' "$destination" "$marketplace"
  exit 0
fi

if [ ! -f "$creator" ] || [ ! -f "$validator" ] || [ ! -f "$marketplace_reader" ] || [ ! -f "$cachebuster" ]; then
  printf 'Codex plugin-creator tooling was not found under %s. Run this from Codex Desktop.\n' "$codex_root" >&2
  exit 1
fi

provision_graphify

marketplace_has_buildroom() {
  python3 - "$marketplace" <<'PY'
import json
import sys
from pathlib import Path

payload = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
plugins = payload.get("plugins", [])
raise SystemExit(0 if any(isinstance(entry, dict) and entry.get("name") == "buildroom" for entry in plugins) else 1)
PY
}

if [ ! -d "$destination" ]; then
  python3 "$creator" buildroom --path "$plugin_parent" --with-skills --with-marketplace --marketplace-path "$marketplace"
elif [ ! -f "$marketplace" ] || ! marketplace_has_buildroom; then
  bootstrap=$(mktemp -d "${TMPDIR:-/tmp}/buildroom-marketplace.XXXXXX")
  python3 "$creator" buildroom --path "$bootstrap" --with-skills --with-marketplace --marketplace-path "$marketplace"
  rm -rf "$bootstrap"
  bootstrap=''
fi

if [ ! -d "$destination" ]; then
  printf 'Expected Buildroom plugin scaffold was not created at %s\n' "$destination" >&2
  exit 1
fi

marketplace_name=$(python3 "$marketplace_reader" --marketplace-path "$marketplace")

mkdir -p "$plugin_parent"
backup="$plugin_parent/.buildroom.previous.$$"
if [ -e "$backup" ]; then
  printf 'Refusing to replace Buildroom while backup path already exists: %s\n' "$backup" >&2
  exit 1
fi
legacy_backup="$plugin_parent/.product-os.previous.$$"
if [ -d "$legacy_destination" ] && [ -e "$legacy_backup" ]; then
  printf 'Refusing to retire Product OS while legacy backup path already exists: %s\n' "$legacy_backup" >&2
  exit 1
fi
mv "$destination" "$backup"
if ! mv "$stage/buildroom" "$destination"; then
  mv "$backup" "$destination"
  backup=''
  exit 1
fi

python3 "$cachebuster" "$destination"
if ! "$codex_command" plugin add "buildroom@$marketplace_name"; then
  rm -rf "$destination"
  mv "$backup" "$destination"
  backup=''
  printf 'Codex installation failed; restored the previous Buildroom plugin source.\n' >&2
  exit 1
fi
rm -rf "$backup"
backup=''

if [ -d "$legacy_destination" ]; then
  mv "$legacy_destination" "$legacy_backup"
  if ! "$codex_command" plugin remove "product-os@$marketplace_name"; then
    mv "$legacy_backup" "$legacy_destination"
    legacy_backup=''
    printf 'Buildroom was installed, but legacy Product OS removal failed; restored its source. Remove product-os@%s manually and retry.\n' "$marketplace_name" >&2
    exit 1
  fi
  rm -rf "$legacy_backup"
  legacy_backup=''
fi
printf 'Installed Buildroom for Codex. Start a new Codex thread to load its skills.\n'
